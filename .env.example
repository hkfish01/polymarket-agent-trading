# AUTOMATON TRADING — Alpaca credentials (never commit this file)
# Get paper keys at https://app.alpaca.markets -> Paper Trading -> API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional mode-specific keys (take precedence over the generic pair above).
# ALPACA_PAPER_API_KEY_ID=
# ALPACA_PAPER_API_SECRET_KEY=
# ALPACA_LIVE_API_KEY_ID=
# ALPACA_LIVE_API_SECRET_KEY=

# Engine mode: sim | paper | live. Live additionally requires allowLive=true and
# the LIVE_ARMED marker file in the state directory.
AUTOMATON_MODE=paper

# Optional overrides (defaults shown).
# AUTOMATON_STATE_DIR=D:\CounterStikers\automaton-data
# AUTOMATON_ENV_FILE=D:\CounterStikers\.env
# AUTOMATON_AUTO_START=false
# AUTOMATON_CYCLE_SEC=300
# AUTOMATON_POPULATION_INITIAL=3
# AUTOMATON_POPULATION_CAP=10
# AUTOMATON_ENDOWMENT_USD=5000
# AUTOMATON_ALLOW_LIVE=false
# AUTOMATON_SYMBOLS=AAPL,MSFT,NVDA,AMD,META,AMZN,GOOGL,TSLA,SPY,QQQ

# Optional: LLM key for the per-agent research sidecar when running the headless CLI
# (`node bin/automaton.mjs run`). Inside the Harness the Host llm service is used instead.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# POLYMARKET VENUE (outcome-market broker) — never commit this file
# ---------------------------------------------------------------------------
# The LLM that drives per-agent probability research. The research sidecar speaks
# standard OpenAI chat-completions, so any OpenAI-compatible endpoint works.
# Example below uses muskspace (TM-deepseek-v4.1). Get a key at https://muskspace.cn/
# RESEARCH_API_KEY=
# RESEARCH_BASE_URL=https://muskspace.cn/v1
# RESEARCH_MODEL=TM-deepseek-v4.1

# Polymarket order entry uses a two-tier auth:
#   L1  the wallet private key signs an EIP-712 order locally (never leaves the machine),
#       then derives L2 API credentials (HMAC).
#   L2  POLY_API_KEY / POLY_SECRET / POLY_PASSPHRASE (cache these to skip re-derivation).
# Chain is Polygon (137). signature_type: 1 = proxy wallet, 3 = deposit wallet.
# For a READ-ONLY dry run you can omit ALL of the POLY_* keys: market discovery, order
# book, and probability pricing are public and need no wallet.
# POLY_PRIVATE_KEY=0x...
# POLY_FUNDER=0x...
# POLY_SIGNATURE_TYPE=1
# POLY_API_KEY=
# POLY_SECRET=
# POLY_PASSPHRASE=
